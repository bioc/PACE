# Everything compiled here parallelises with std::thread, so there is no OpenMP
# to ask for and no libomp to find on macOS.
PKG_LIBS = -pthread

# Set by ./configure.win; see src/Makevars.in for why.
# @PTHREAD@ is -pthread when the compiler accepts it at COMPILE time, which is
# separate from having it in PKG_LIBS above. Emscripten needs it on both: its R
# is built with shared memory, so it links with --shared-memory, and that is
# refused unless every object was compiled with the atomics and bulk-memory
# features that -pthread turns on. Without it the webR build failed at the link
# with "--shared-memory is disallowed by RcppExports.o". On Linux, macOS and
# MinGW it only defines _REENTRANT and changes nothing else.
PKG_CXXFLAGS = @FPCONTRACT@ @PTHREAD@


OBJECTS = RcppExports.o bindings.o \
          core/thread_pool.o core/stage_timer.o core/neighbourhood.o core/count_stats.o \
          core/statistics.o core/decomposition.o \
          core/irls_chunk.o core/hyperparameters.o core/gene_solve.o \
          core/dispersion.o core/preprocess.o \
          core/linear_predictor.o core/irls_driver.o \
          core/random_design.o core/sparse_product.o core/mash.o bindings_random_design.o
